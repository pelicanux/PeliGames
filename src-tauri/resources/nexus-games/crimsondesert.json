    },
    {
      "name": "version",
      "file": "bin64/version.dll"
    }
  ],
  "sources": [
    "https://store.steampowered.com/app/3321460/",
    "https://crimsondesert.pearlabyss.com/pt-br/News/Notice/Detail?_boardNo=40",
