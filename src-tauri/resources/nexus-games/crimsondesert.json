    "https://www.nexusmods.com/crimsondesert/mods/95",
    "https://www.nexusmods.com/crimsondesert/mods/107?tab=files",
    "https://github.com/faisalkindi/CrimsonDesert-UltimateModsManager/blob/master/LINUX.md",
    "https://github.com/faisalkindi/CrimsonDesert-UltimateModsManager#supported-formats",
    "https://github.com/ThirteenAG/Ultimate-ASI-Loader"
