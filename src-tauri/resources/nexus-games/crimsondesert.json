    },
    {
      "kind": "extension",
      "extension": ".ini",
      "target": "bin64/",
      "root_only": false
    }
  ],
  "frameworks": [
    {
      "name": "Ultimate ASI Loader (x64)",
      "mod_id": 0,
      "url": "https://github.com/ThirteenAG/Ultimate-ASI-Loader/releases",
      "required_files": [],
