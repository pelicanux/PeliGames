{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeliGames",
  "mainBinaryName": "peligames",
  "version": "0.3.0",
  "identifier": "com.pelicano.peligames",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PeliGames",
        "width": 1200,
        "height": 850,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher de jogos Windows para Linux com Proton",
    "longDescription": "PeliGames integra biblioteca, Proton, ferramentas Wine, Pelinstall e gerenciamento de mods.",
    "icon": [
      "icons/generated/32x32.png",
      "icons/generated/128x128.png",
      "icons/generated/128x128@2x.png",
      "icons/generated/icon.icns",
      "icons/generated/icon.ico"
    ],
    "resources": {
      "../licenses/": "licenses/",
      "../LICENSE": "licenses/PeliGames-GPL-3.0.txt"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/launcher.desktop",
        "files": {
          "/usr/share/applications/pelinstall.desktop": "packaging/pelinstall.desktop",
          "/usr/bin/pelinstall": "packaging/pelinstall",
          "/usr/bin/peligames": "packaging/peligames",
          "/usr/share/icons/hicolor/scalable/apps/peligames.svg": "../public/peligames.svg"
        },
        "depends": [
          "libsecret-tools",
          "libarchive13 | libarchive13t64"
        ]
      },
      "rpm": {
        "desktopTemplate": "packaging/launcher.desktop",
        "files": {
          "/usr/share/applications/pelinstall.desktop": "packaging/pelinstall.desktop",
          "/usr/bin/pelinstall": "packaging/pelinstall",
          "/usr/share/icons/hicolor/scalable/apps/peligames.svg": "../public/peligames.svg"
        },
        "depends": [
          "libsecret",
          "libarchive"
        ]
      }
    }
  }
}
