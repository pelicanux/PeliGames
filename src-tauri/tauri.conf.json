{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeliGames",
  "version": "0.8.2",
  "identifier": "com.pelicano.peligames",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PeliGames",
        "width": 1200,
        "height": 850,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher de jogos Windows para Linux com Proton",
    "longDescription": "PeliGames integra biblioteca, Proton, ferramentas Wine, Pelinstall e gerenciamento de mods.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/launcher.desktop",
        "files": {
          "/usr/share/applications/pelinstall.desktop": "packaging/pelinstall.desktop",
          "/usr/bin/Pelinstall": "packaging/Pelinstall",
          "/usr/bin/PeliGames": "packaging/PeliGames"
        }
      },
      "rpm": {
        "desktopTemplate": "packaging/launcher.desktop",
        "files": {
          "/usr/share/applications/pelinstall.desktop": "packaging/pelinstall.desktop",
          "/usr/bin/Pelinstall": "packaging/Pelinstall"
        }
      }
    }
  }
}
