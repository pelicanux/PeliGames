{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "jsx": "react-jsx", "resolveJsonModule": true,
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src"]
}
